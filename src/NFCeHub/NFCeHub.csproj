<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>NFCeHub</RootNamespace>
    <AssemblyName>NFCeHub</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFCeHub.Core\NFCeHub.Core.csproj" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\pbtec_logo.png" />
    <Resource Include="Assets\pbtec_logo_light.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
