<Window x:Class="NFCeHub.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NFCeHub"
        Title="NFCeHub" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True">
    <StackPanel Width="460" Margin="28,24,28,24">
        <DockPanel>
            <Grid DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse x:Name="BadgeBack" />
                <local:IconView x:Name="BadgeIcon" Size="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource TextBase}" FontSize="18.667" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Style="{StaticResource SmallText}" FontSize="{StaticResource BodySize}"
                           Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <Border Width="56" Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="60,14,0,0"
                Background="{DynamicResource GradientBrush}" />
        <ContentControl x:Name="BodyHost" Margin="0,18,0,0" Focusable="False" IsTabStop="False" />
        <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0" />
    </StackPanel>
</Window>
