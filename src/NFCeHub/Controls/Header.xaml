<UserControl x:Class="NFCeHub.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas x:Name="Root" Height="122" ClipToBounds="False">
        <Image x:Name="LogoImage" Height="96" Canvas.Top="2" Canvas.Right="0" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel x:Name="Eyebrow" Orientation="Horizontal" Canvas.Top="6" />
        <TextBlock x:Name="TitleText" Canvas.Left="-2" Canvas.Top="20" FontFamily="{StaticResource UiFont}"
                   FontSize="{StaticResource TitleSize}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                   TextOptions.TextFormattingMode="Display" />
        <TextBlock x:Name="SubtitleText" Canvas.Top="65" FontFamily="{StaticResource UiFont}"
                   FontSize="{StaticResource SubtitleSize}" Foreground="{DynamicResource MutedBrush}"
                   TextOptions.TextFormattingMode="Display" />
        <Border x:Name="Bar" Width="56" Height="3" CornerRadius="1.5" Canvas.Top="98.5"
                Background="{DynamicResource GradientBrush}" />
        <Canvas x:Name="Status" Canvas.Left="80" Canvas.Top="100">
            <Ellipse x:Name="Ring" Width="21.5" Height="21.5" Canvas.Left="-10.75" Canvas.Top="-10.75"
                     StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" ScaleX="0.4" ScaleY="0.4" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot" Width="8" Height="8" Canvas.Left="-4" Canvas.Top="-4" />
            <Rectangle x:Name="StatusHit" Width="24" Height="24" Canvas.Left="-12" Canvas.Top="-12" Fill="Transparent"
                       ToolTipService.InitialShowDelay="0" ToolTipService.Placement="Right" />
        </Canvas>
    </Canvas>
</UserControl>
